# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# AI provider: choose "groq" or "openai"
AI_PROVIDER=groq

# Groq (required when AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b

# OpenAI (required when AI_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# Use a long, random value. Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace_with_a_long_random_secret

# Legacy Supabase aliases are also supported, but the canonical names above are preferred:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key
